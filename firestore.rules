rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(cid))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
    }

    // Each person's own name + chat list (partner UID + shared code). Only that person can read/write it.
    // true unless the other member of this chat has blocked the caller
    function notBlocked(cid) {
      let m = get(/databases/$(database)/documents/chats/$(cid)).data.members;
      let other = m[0] == request.auth.uid ? m[1] : m[0];
      return !exists(/databases/$(database)/documents/users/$(other)/blocks/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'contacts', 'updatedAt', 'mode', 'ob'])
        && (!('ob' in request.resource.data) || (request.resource.data.ob is map
            && request.resource.data.ob.keys().hasOnly(['age', 'gender', 'since', 'title', 'lang'])
            && (!('age' in request.resource.data.ob) || (request.resource.data.ob.age is int && request.resource.data.ob.age >= 16 && request.resource.data.ob.age <= 120))
            && (!('title' in request.resource.data.ob) || (request.resource.data.ob.title is string && request.resource.data.ob.title.size() <= 40))
            && (!('since' in request.resource.data.ob) || (request.resource.data.ob.since is string && request.resource.data.ob.since.size() <= 10))))
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['couple', 'regular'])
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.contacts is list
        && request.resource.data.contacts.size() <= 100;
      allow delete: if false;
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token','updatedAt','userAgent','hideMode','lock'])
          && request.resource.data.get('hideMode','auto') in ['auto','on','off']
          && request.resource.data.get('lock',false) is bool
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 2000;
      }
      match /blocks/{blockedUid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && blockedUid != uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is int;
      }
      match /period/config {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Phone directory: lets a partner find your account by number. Lookup of one number only, no listing.
    // Doc id is a hash of the number. A number can be linked to one account (first come, first served).
    // reports are write-only for users; read them in the Firebase console or with the Admin SDK
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'target', 'cid', 'reason', 'note', 'ts'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.target is string && request.resource.data.target.size() <= 128
        && request.resource.data.cid is string && request.resource.data.cid.size() <= 128
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'underage', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.ts is int;
      allow read, update, delete: if false;
    }

    // plan of each user (written only by the server after a verified Google Play purchase)
    match /planByUid/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /phones/{h} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // QR connect: someone who scanned your QR leaves a request here. Only they can write it, only you can read/delete it.
    match /invites/{ownerUid}/requests/{fromUid} {
      allow create, update: if signedIn() && request.auth.uid == fromUid
        && request.resource.data.keys().hasOnly(['name', 'ts', 'code'])
        && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 64))
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.ts is int;
      allow read, delete: if signedIn() && request.auth.uid == ownerUid;
    }

    match /statuses/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','text','ts','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 240
        && request.resource.data.ts is int;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // v59 Love Corner: server-side scheduled messages + daily care reminders (owner only; the Cloud Function reads them with admin rights).
    match /lvSched/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['cid','fromUid','due','ttl','msg','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.due is int
        && request.resource.data.msg.fromUid == request.auth.uid
        && request.resource.data.msg.type == 'text'
        && isMember(request.resource.data.cid);
      allow read, delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }
    match /lvRules/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['cid','fromUid','toUid','kind','hm','tz','on','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && isMember(request.resource.data.cid);
      allow read, delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && resource.data.fromUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['on']);
    }

    // v65: cloud backup of app settings (theme, stickers, labels, pins...). Only the owner can read or write it.
    match /backups/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'json'])
        && request.resource.data.at is number
        && request.resource.data.json is string && request.resource.data.json.size() < 900000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /chats/{cid} {
      // Non-members may only check a missing room; existing room metadata is members-only.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/chats/$(cid)) || request.auth.uid in resource.data.members);
      allow list: if false;
      // Create a room once with the signed-in user and one partner UID.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt is int;
      allow update, delete: if false;

      // Status (24 h): members of the chat can read; only the author posts/deletes; a viewer may only add their own entry to `views`.
      match /statuses/{sid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && notBlocked(cid)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasAll(['fromUid', 'ts', 'exp', 'type'])
          && request.resource.data.type in ['img', 'vid', 'text']
          && request.resource.data.ts is int
          && request.resource.data.exp is int;
        allow update: if isMember(cid)
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
        allow delete: if isMember(cid) && resource.data.fromUid == request.auth.uid;
      }

      match /messages/{mid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && notBlocked(cid)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasAll(['fromUid', 'from', 'ts', 'type'])
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 8000))
          && (!('data' in request.resource.data) || (request.resource.data.data is string && request.resource.data.data.size() <= 950000));
        allow update: if isMember(cid)
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.from == resource.data.from
          && request.resource.data.ts == resource.data.ts
          && request.resource.data.type == resource.data.type
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dlv', 'read', 'r', 'pinned', 'votes'])
            || (resource.data.fromUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dele', 'text', 'data', 'url', 'rep', 'et', 'eq', 'etr', 'r', 'dlv', 'read', 'edited', 'pinned']))
            // Recipient may open a view-once photo/video exactly once: it marks it opened and wipes the media.
            || (resource.data.fromUid != request.auth.uid
                && resource.data.get('once', false) == true
                && !('vo' in resource.data)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vo', 'data', 'url'])
                && request.resource.data.get('data', '') == ''
                && request.resource.data.get('url', '') == '')
          );
        // Sender may delete own messages (disappearing messages cleanup).
        allow delete: if isMember(cid) && resource.data.fromUid == request.auth.uid;
      }
      // Screen share / whiteboard signalling (members only).
      match /share/{sid} {
        allow read, write: if isMember(cid);
        match /ice/{iid} {
          allow read, write: if isMember(cid);
        }
      }
      // Real-time multiplayer games. Only chat members can see or change the shared game state.
      match /games/{gid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && notBlocked(cid);
      }
      // Private shared couple hub: notes, moods, memories, dates, surprises, places, music and lists.
      match /coupleHub/{hid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && notBlocked(cid);
      }
      match /presence/{pid} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid)
          && pid == request.auth.uid
          && request.resource.data.phoneKey == request.auth.uid;
        allow delete: if isMember(cid) && pid == request.auth.uid;
      }
    }
  }
}
